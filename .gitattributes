# 统一换行符：仓库内一律 LF，检出时由 Git 处理
* text=auto eol=lf

# Windows 脚本必须保留 CRLF，否则可能无法执行
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 声明为二进制：Git 不做行尾转换、不做文本 diff
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.ico   binary
*.svg   text
*.zip   binary
*.7z    binary
*.rar   binary
*.xlsx  binary
*.docx  binary
*.pptx  binary
*.hex   binary
*.bin   binary
*.elf   binary
*.so    binary
*.a     binary
*.lib   binary
*.dll   binary
*.exe   binary
*.wav   binary
*.mp3   binary
*.mp4   binary
*.fig   binary
*.mat   binary
*.slx   binary

# 语言与图表
*.md    text
*.py    text
*.c     text
*.h     text
*.cpp   text
*.hpp   text
*.v     text
*.sv    text
*.vhd   text
*.m     text
*.tex   text
*.json  text
*.yml   text
*.yaml  text

# -----------------------------------------------------------------------------
# Git LFS（默认关闭，需要时再启用）
#
# 免费额度有限（1 GB 存储 + 1 GB/月流量），图片/波形/位流等大文件
# 确实需要入库时再打开。启用步骤：
#   git lfs install
#   取消下面任一行的注释
#   git lfs track "*.png"
#   git add .gitattributes
#
# *.png  filter=lfs diff=lfs merge=lfs -text
# *.jpg  filter=lfs diff=lfs merge=lfs -text
# *.pdf  filter=lfs diff=lfs merge=lfs -text
# *.zip  filter=lfs diff=lfs merge=lfs -text
# -----------------------------------------------------------------------------
