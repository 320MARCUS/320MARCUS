.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
*.secret
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
.npmrc
.pypirc
credentials.json
secrets.json
secrets.yaml
secrets.yml
.aws/
.ssh/
.gnupg/
*.kdbx

